# Configuration Générale Django
SECRET_KEY=votre_cle_secrete_django_ici
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,*

# Configuration Base de Données (MySQL / MariaDB)
# Si MYSQL_HOST est renseigné, Django se connectera à MySQL via PyMySQL.
# Si MYSQL_HOST est vide, Django basculera automatiquement sur SQLite (oxmember.db).
MYSQL_HOST=localhost
MYSQL_DATABASE=oxmember_db
MYSQL_USER=root
MYSQL_PASSWORD=votre_mot_de_passe
MYSQL_PORT=3306
